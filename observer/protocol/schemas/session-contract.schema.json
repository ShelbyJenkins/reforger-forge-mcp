{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reforger-forge.dev/observer/v1/session-contract.schema.json",
  "$comment": "Generated by npm run protocol:generate. Do not edit.",
  "title": "Observer session contract",
  "type": "object",
  "required": ["protocolVersion", "addonVersion", "bundleDigest", "buildIdentity", "expectedRuntimeKind", "sessionId", "launchNonce", "sessionToken", "createdAt", "expiresAt", "agent", "transportPreference", "profileDirectoryName", "limits"],
  "properties": {
    "protocolVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "addonVersion": { "type": "string", "maxLength": 32 },
    "bundleDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "buildIdentity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "expectedRuntimeKind": { "enum": ["client", "listenServer", "dedicated", "workbench", "testRunner"] },
    "sessionId": { "$ref": "#/$defs/id" },
    "launchNonce": { "$ref": "#/$defs/secret" },
    "sessionToken": { "$ref": "#/$defs/secret" },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "expiresAtUnix": { "type": "integer", "minimum": 1 },
    "agent": {
      "type": "object",
      "required": ["host", "port", "instanceId"],
      "properties": { "host": { "enum": ["127.0.0.1", "::1"] }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 }, "instanceId": { "$ref": "#/$defs/id" } }
    },
    "transportPreference": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "enum": ["rest", "mailbox"] } },
    "profileDirectoryName": { "const": "ReforgerForgeObserver" },
    "limits": {
      "type": "object",
      "required": ["maxPendingJobs", "maxCaptureRatePerMinute", "maxArtifactBytes", "minFov", "maxFov", "maxSettleFrames", "maxCaptureDistance"],
      "properties": {
        "maxPendingJobs": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxCaptureRatePerMinute": { "type": "integer", "minimum": 1, "maximum": 600 },
        "maxArtifactBytes": { "type": "integer", "minimum": 1024, "maximum": 67108864 },
        "minFov": { "type": "integer", "minimum": 1, "maximum": 179 },
        "maxFov": { "type": "integer", "minimum": 1, "maximum": 179 },
        "maxSettleFrames": { "type": "integer", "minimum": 0, "maximum": 30 },
        "maxCaptureDistance": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,96}$" },
    "secret": { "type": "string", "pattern": "^[A-Za-z0-9_-]{32,256}$" }
  }
}
