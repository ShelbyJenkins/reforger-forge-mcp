{
  "name": "reforger-forge-mcp",
  "version": "1.1.0",
  "type": "module",
  "description": "Universal MCP server for Arma Reforger modding — works with any AI agent (Cursor, Claude, Kiro, VS Code)",
  "bin": {
    "reforger-forge-mcp": "./dist/index.js",
    "reforger-forge-workbench": "./dist/workbench/runner-cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:mcp": "tsc -p tsconfig.build.json",
    "build:observer": "tsc -p observer/tsconfig.build.json",
    "build": "npm run clean && npm run build:mcp && npm run build:observer",
    "dev": "tsx src/index.ts",
    "scrape": "tsx scripts/scrape.ts",
    "scrape:remote": "tsx scripts/scrape.ts --source remote",
    "scrape:local": "tsx scripts/scrape.ts --source local",
    "protocol:generate": "tsx scripts/generate-protocol-artifacts.ts",
    "protocol:check": "tsx scripts/generate-protocol-artifacts.ts --check",
    "test": "vitest run",
    "test:integration": "vitest run tests/workbench/project-launcher-safety.test.ts tests/animation/integration-m151a2.test.ts",
    "test:observer:integration": "vitest run tests/observer/integration",
    "addons:manifest": "node scripts/update-observer-source-manifest.mjs",
    "observer:manifest": "npm run addons:manifest",
    "observer:validate:enforce": "node scripts/validate-observer-enforce.mjs",
    "observer:acceptance:enforce-mailbox": "node scripts/run-observer-enforce-mailbox-acceptance.mjs",
    "dev:observer:acceptance:workbench": "npm run build && tsx scripts/run-workbench-observer-acceptance.ts",
    "dev:observer:acceptance:runtime": "npm run build && tsx scripts/run-runtime-observer-acceptance.ts",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "adm-zip": "^0.5.16",
    "cheerio": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.0.0",
    "playwright": "^1.58.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "data",
    "observer/addon",
    "observer/workbench-addon",
    "observer/protocol",
    "observer/README.md",
    "configs",
    "docs/AGENTS.md",
    "reforger-forge.config.example.json",
    "scripts/check-package.mjs",
    "scripts/install-agents.ps1",
    "scripts/list-tools.mjs",
    "scripts/run-observer-enforce-mailbox-acceptance.mjs",
    "scripts/update-observer-source-manifest.mjs",
    "scripts/setup.ps1",
    "scripts/windows/workbench-lifecycle.ps1",
    "tests/fixtures/enforce-mailbox-acceptance-addon/addon.gproj",
    "tests/fixtures/enforce-mailbox-acceptance-addon/Scripts/WorkbenchGame/RFO_MailboxAcceptancePlugin.c",
    "RELEASE_NOTES_v1.1.0.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wastelandgoats/reforger-forge-mcp.git"
  },
  "homepage": "https://github.com/wastelandgoats/reforger-forge-mcp",
  "bugs": {
    "url": "https://github.com/wastelandgoats/reforger-forge-mcp/issues"
  },
  "author": "Goatboy",
  "license": "MIT",
  "keywords": [
    "mcp",
    "arma-reforger",
    "enfusion",
    "modding",
    "model-context-protocol",
    "workbench",
    "cursor",
    "claude",
    "ai-agent",
    "reforger-forge"
  ]
}
